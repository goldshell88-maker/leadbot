#!/bin/bash
# Живой поток с боевого сервера бота: клиент → оператор → бот → почему.
# Двойной клик в Finder. Выход — Ctrl+C.
#
# ⚠ Читаем ЖУРНАЛ, а не базу: смотрелка ничего не спрашивает у сервера и ничего на нём
# не меняет. Обрыв связи не роняет ни бота, ни просмотр — tail сам переподключится
# при следующем запуске.
cd "$(dirname "$0")" || exit 1
СЕРВЕР=${LEADBOT_SSH:-leadchat-watch}
ЖУРНАЛ=${LEADBOT_SHADOW_FILE:-/opt/leadbot/data/shadow.jsonl}

printf '\033]0;Лид-бот · живой поток\007'
echo "сервер: $СЕРВЕР"
echo "журнал: $ЖУРНАЛ"
echo

# ⚠ ФАЙЛ СОЗДАЁМ ДО tail. Пока бот не сделал ни одного хода, журнала на сервере нет,
# и tail встречает пользователя строкой «cannot open … No such file» — читается как
# поломка, хотя это просто тишина. Пустой файл делает ожидание тихим и понятным.
ssh -o ServerAliveInterval=20 -o ConnectTimeout=10 "$СЕРВЕР" \
    "mkdir -p \"\$(dirname '$ЖУРНАЛ')\"; touch '$ЖУРНАЛ'; tail -n 40 -F '$ЖУРНАЛ'" \
  | uv run python analysis/watch.py

echo
echo "поток закрыт. Окно можно закрывать."
