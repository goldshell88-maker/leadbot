#!/bin/bash
# Учебный прогон по ЖИВЫМ диалогам корпуса: на каждом ходе видно, что спросил клиент,
# что ответил живой мастер и что ответил бы бот. Двойной клик в Finder.
cd "$(dirname "$0")" || exit 1
printf '\033]0;Лид-бот · учебный прогон\007'

echo "Как учимся?"
echo "  1) бесплатно — по записи эталона, 30 замороженных диалогов, 0 токенов"
echo "  2) на свежих диалогах корпуса — живые вызовы модели, ЭТО СТОИТ ДЕНЕГ"
printf "выбор [1]: "
read -r режим
режим=${режим:-1}

printf "сколько диалогов [5]: "
read -r сколько
сколько=${сколько:-5}

printf "пауза между ходами, сек [1]: "
read -r пауза
пауза=${пауза:-1}

echo
if [ "$режим" = "2" ]; then
  echo "живой прогон: $сколько диалогов, модель отвечает по-настоящему"
  uv run python analysis/replay.py "$сколько" --пауза "$пауза" 2>/dev/null \
    | uv run python analysis/watch.py
else
  uv run python analysis/replay.py "$сколько" --кассета --пауза "$пауза" 2>/dev/null \
    | uv run python analysis/watch.py
fi

echo
echo "прогон закончен. Окно можно закрывать."
